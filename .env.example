# Copy to .env on the machine that runs the upload API.
# Never commit .env. Never paste these values into chat.

# Origin of the public wedding page. The API accepts uploads only from this site,
# plus localhost while you are developing.
PUBLIC_ORIGIN=https://klikdovencanja.rs
# Optional extra origins, comma-separated.
PUBLIC_ORIGINS=

# Leave empty for local development. Vite already proxies /api/memories.
# On GitHub, set this as an Actions variable before the production build:
# VITE_MEMORIES_API_URL=https://your-service.up.railway.app
VITE_MEMORIES_API_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/memories/oauth/callback

# Folder you create in your own Google Drive. The API never lists it publicly.
GOOGLE_DRIVE_FOLDER_ID=

# Needed so uploads can land in a folder you created yourself.
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# A long random string you invent. It only unlocks the one-time Google connection
# and signs upload proofs when PROOF_SECRET is empty.
OWNER_SETUP_SECRET=
PROOF_SECRET=

# Preferred on Railway. When set, the encrypted volume file is not used.
GOOGLE_REFRESH_TOKEN=

# Railway volume mount, for example /data. The refresh token is encrypted here.
DATA_DIR=
# 32-byte hex key, or a long passphrase. Required to write the volume file.
TOKEN_ENCRYPTION_KEY=

MAX_FILE_BYTES=5368709120
MAX_FILES_PER_BATCH=40

# Railway sets PORT. Locally this falls back to API_PORT.
API_PORT=8787
# Railway needs every interface. This is the default when API_HOST is empty.
API_HOST=0.0.0.0

# Set TRUST_PROXY=1 only behind Railway. Hops is how many proxies append an address.
TRUST_PROXY=
TRUST_PROXY_HOPS=1
